# Образец для нового .env; действующие секреты сюда не копировать.
# Все параметры: docs/configuration.md.

# PostgreSQL: значения по умолчанию только для локального запуска.
# В Compose DATABASE_URL приложения собирается из POSTGRES_PASSWORD и хоста db.
DATABASE_URL=postgresql+psycopg://polyrental:polyrental@db:5432/polyrental
POSTGRES_PASSWORD=polyrental
# Необязательный кэш публичных данных; без Redis приложение читает PostgreSQL.
REDIS_URL=redis://redis:6379/0

# Бот и публичный адрес. BOT_USERNAME — без @; production использует HTTPS.
BOT_TOKEN=
BOT_USERNAME=
PUBLIC_URL=http://localhost:8000
# Канал обычных релизов: @channel_name или числовой ID; пусто — не публиковать.
# Боту нужны права публикации. Hotfix не создаёт отдельного поста.
RELEASE_CHANNEL=
# 1 — только для отдельного бота тестового сервера Telegram; production: 0.
TELEGRAM_TEST_ENVIRONMENT=0
# Срок действия Telegram initData/данных входа, секунды.
TELEGRAM_AUTH_MAX_AGE=86400
# Необязательный прокси бота; пустую строку задавать не требуется.
# HTTPS_PROXY=http://proxy.example:8080

# Положительные Telegram ID через запятую. ADMIN_IDS обязателен.
# Подроли сотрудников хранятся в БД; PII-доступ задаётся независимо.
ADMIN_IDS=123456789
PII_ADMIN_IDS=123456789

# Разные случайные значения длиной не менее 32 символов.
SESSION_SECRET=
ICAL_TOKEN=
# Два разных ключа: по 32 случайных байта в base64url.
PII_MASTER_KEY=
BACKUP_MASTER_KEY=

# Реквизиты оператора для согласия на обработку данных.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_CONTACT=
PRIVACY_POLICY_VERSION=2026-10-30-v4
# local: Pillow + локальный Tesseract rus/eng; manual: ручная проверка.
DOCUMENT_CHECK_MODE=local
# Необязательные серверные подсказки адресов; пусто — ручной ввод.
DADATA_API_KEY=
# Только для совместимого PDF-генератора; новые расписки — DOCX.
# RECEIPT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Исключения планового календаря по МСК: даты YYYY-MM-DD через запятую.
NON_WORKING_DATES=
WORKING_DATES=
# Ограничивает плановые даты/время; фактические этапы доступны круглосуточно.
ENFORCE_HANDOVER_SCHEDULE=true
# Отдельные праздники SLA, YYYY-MM-DD через запятую.
SLA_HOLIDAYS=
# ID общего Telegram-чата эскалаций; пусто — общий чат отключён.
SLA_SHARED_CHAT_ID=
# Окно отмены скрытия заявки, секунды; приложение ограничивает 1–30.
UNDO_DELETE_SECONDS=5

# Пороги scripts/check_storage.py; сами по себе мониторинг не запускают.
DATABASE_WARN_GIB=5
BACKUP_WARN_GIB=50
BACKUP_MAX_AGE_HOURS=26
