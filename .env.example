DATABASE_URL=postgresql+psycopg://polyrental:polyrental@db:5432/polyrental
POSTGRES_PASSWORD=polyrental
# Redis stores only public catalogue data; the application falls back to PostgreSQL.
REDIS_URL=redis://redis:6379/0
BOT_TOKEN=
DADATA_API_KEY=
BOT_USERNAME=
# Optional channel for automatic regular-release posts; hotfixes do not create posts.
RELEASE_CHANNEL=
# Only for a separate bot/account on Telegram's test server. Production: 0.
TELEGRAM_TEST_ENVIRONMENT=0
ADMIN_IDS=123456789
# ADMIN_IDS is required and strictly validated in bot, Mini App and web.
# PII admins are also staff; ordinary admins cannot read identity documents.
PII_ADMIN_IDS=123456789
# local: Pillow + local Tesseract (rus/eng); manual: always manual moderation.
DOCUMENT_CHECK_MODE=local
PII_MASTER_KEY=
BACKUP_MASTER_KEY=
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_CONTACT=
PRIVACY_POLICY_VERSION=2026-10-30-v4
PUBLIC_URL=http://localhost:8000
SESSION_SECRET=replace-with-a-long-random-secret
ICAL_TOKEN=replace-with-a-different-long-random-token
TELEGRAM_AUTH_MAX_AGE=86400
# Institution-specific Moscow calendar overrides, comma-separated YYYY-MM-DD dates.
NON_WORKING_DATES=
WORKING_DATES=
# Enforce Moscow handover hours. Disable only during a controlled legacy rollback.
ENFORCE_HANDOVER_SCHEDULE=true
# SLA calendar holidays, independent of the issue/return calendar; YYYY-MM-DD, comma-separated.
SLA_HOLIDAYS=
# Seconds to undo an operator request deletion before it is saved.
UNDO_DELETE_SECONDS=5
# Telegram chat ID for shared SLA escalations (negative for groups); leave empty until configured.
SLA_SHARED_CHAT_ID=

# Read-only storage monitoring: scripts/check_storage.py BACKUP_DIRECTORY
DATABASE_WARN_GIB=5
BACKUP_WARN_GIB=50
BACKUP_MAX_AGE_HOURS=26
